{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://citizen-scheme-assistant.org/schemas/eligibility-result.schema.json",
  "title": "EligibilityEvaluationResult",
  "description": "Output generated by the engine evaluating all schemes against a citizen profile.",
  "type": "object",
  "required": ["timestamp", "language", "schemes_evaluated", "results"],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "language": {
      "type": "string",
      "enum": ["hi", "en"]
    },
    "schemes_evaluated": {
      "type": "integer",
      "minimum": 0
    },
    "summary_counts": {
      "type": "object",
      "required": ["eligible", "ineligible", "uncertain"],
      "properties": {
        "eligible": { "type": "integer" },
        "ineligible": { "type": "integer" },
        "uncertain": { "type": "integer" }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scheme_id",
          "scheme_name",
          "category",
          "status",
          "decisive_rule",
          "official_source",
          "document_checklist"
        ],
        "properties": {
          "scheme_id": { "type": "string" },
          "scheme_name": {
            "type": "object",
            "required": ["en", "hi"],
            "properties": {
              "en": { "type": "string" },
              "hi": { "type": "string" }
            }
          },
          "category": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["ELIGIBLE", "INELIGIBLE", "UNCERTAIN"]
          },
          "confidence_score": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "decisive_rule": {
            "type": "object",
            "required": ["en", "hi"],
            "description": "Jargon-free explanation of the exact rule that decided this status.",
            "properties": {
              "en": { "type": "string" },
              "hi": { "type": "string" }
            }
          },
          "uncertainty_details": {
            "type": ["object", "null"],
            "properties": {
              "reason": {
                "type": "object",
                "required": ["en", "hi"],
                "properties": {
                  "en": { "type": "string" },
                  "hi": { "type": "string" }
                }
              },
              "missing_fields": {
                "type": "array",
                "items": { "type": "string" }
              },
              "is_borderline_income": { "type": "boolean" },
              "is_stale_rule": { "type": "boolean" },
              "resolution_advice": {
                "type": "object",
                "required": ["en", "hi"],
                "properties": {
                  "en": { "type": "string" },
                  "hi": { "type": "string" }
                }
              }
            }
          },
          "official_source": {
            "type": "object",
            "required": ["url", "last_checked_date", "is_stale"],
            "properties": {
              "url": { "type": "string" },
              "last_checked_date": { "type": "string" },
              "is_stale": {
                "type": "boolean",
                "description": "True if last_checked_date is older than 180 days."
              },
              "issuing_ministry": {
                "type": "object",
                "properties": {
                  "en": { "type": "string" },
                  "hi": { "type": "string" }
                }
              }
            }
          },
          "document_checklist": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "title", "issuing_authority"],
              "properties": {
                "id": { "type": "string" },
                "title": {
                  "type": "object",
                  "required": ["en", "hi"],
                  "properties": {
                    "en": { "type": "string" },
                    "hi": { "type": "string" }
                  }
                },
                "issuing_authority": {
                  "type": "object",
                  "required": ["en", "hi"],
                  "properties": {
                    "en": { "type": "string" },
                    "hi": { "type": "string" }
                  }
                },
                "guidance": {
                  "type": "object",
                  "properties": {
                    "en": { "type": "string" },
                    "hi": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

