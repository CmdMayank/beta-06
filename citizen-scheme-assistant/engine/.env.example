# Server-only settings. Copy to engine/.env; never commit the filled file.
# Get the host/port/database from Supabase Dashboard > Connect.
# Use the dedicated scheme_api LOGIN, not postgres, anon, or service_role.
# For a session pooler the username is scheme_api.PROJECT_REF.
DATABASE_URL=postgresql://scheme_api:REPLACE_WITH_URL_ENCODED_PASSWORD@REPLACE_WITH_HOST:5432/postgres
DATABASE_SSL_ROOT_CERT=C:/secure/path/to/supabase-ca.crt
# Must match the actual PostgreSQL login (without the pooler's .PROJECT_REF suffix).
DATABASE_EXPECTED_USER=scheme_api
# Integration CLI only; not required by FastAPI or smoke test. Not a secret.
SUPABASE_PROJECT_REF=REPLACE_WITH_PROJECT_REF
# No Supabase API keys or service-role keys are needed for a SQL connection.
# Comma-separated exact origins; replace with explicit HTTPS frontend origins in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
