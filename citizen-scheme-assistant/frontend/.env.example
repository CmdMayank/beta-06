# Public build-time settings only. Never put Gemini/database/service-role keys here.
VITE_DEFAULT_LANGUAGE=hi
# Local development can omit this (defaults to http://127.0.0.1:8002).
# Production: use the actual HTTPS FastAPI origin, or leave empty and configure
# the frontend host to proxy /api and /health to FastAPI.
VITE_API_BASE_URL=
# Optional public Supabase auth settings: only an anon/publishable key belongs here.
# VITE_SUPABASE_URL=REPLACE_WITH_PUBLIC_SUPABASE_URL
# VITE_SUPABASE_ANON_KEY=REPLACE_WITH_PUBLIC_ANON_KEY
