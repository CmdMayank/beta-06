# Frontend Environment Variables (Vite prefixed with VITE_)
# Frontend runs on React + Vite (JavaScript)
VITE_APP_TITLE=Citizen Scheme Assistant
VITE_DEFAULT_LANGUAGE=hi
VITE_SUPPORTED_LANGUAGES=hi,en
VITE_API_BASE_URL=http://127.0.0.1:8002

# Local defaults only. Vite reads frontend/.env.local, not this project-root file.
# For a deployed frontend, set VITE_API_BASE_URL to the real HTTPS FastAPI origin
# before building, or omit it and proxy /api and /health on the frontend host.
# Never use localhost in a remotely hosted build. Never add server keys here.
# Backend settings belong to engine/.env (see engine/.env.example).
PORT=8002

